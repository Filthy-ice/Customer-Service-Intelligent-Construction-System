# ── Rust / Cargo ──
/target/
**/target/
debug/
Cargo.toml.orig
**/*.rs.bk

# ── 平台构建产物 ──
# MSVC 调试符号（Win）
*.pdb

# ── 桌面端（Tauri，M2 起）──
node_modules/
apps/desktop/dist/
apps/desktop/ui/.vite/
*.local

# ── 本地数据与运行时产物（永不入库）──
/.icewright/
/workspaces/
/output/
/eval-runs/
/logs/
*.log

# ── 秘密与本地覆盖（引擎设计上只允许 keyring 引用，这里是第二道闸）──
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/
icewright.local.toml

# ── 内部规划文档（纪律兜底：设计叙述类文档只放仓库外 docs-internal/）──
/docs-internal/

# ── 编辑器 / OS ──
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

