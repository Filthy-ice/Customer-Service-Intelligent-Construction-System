# AUTO-GENERATED BY IceWright {{engine_version}} · init/config.example.env
# {{project_name}}（{{pack_ref}}）全部运行时配置项的集中清单（三栈一致）。
#
# 配置纪律：应用运行时只读 IW_* 环境变量，代码与包内文件零硬编码。
#   - 本机/裸机：cp 本文件为 .env 后 `set -a; . ./.env; set +a`（python 栈 uvicorn 前 source）
#   - 容器：K8s Secret/ConfigMap 或 docker --env-file 注入同名环境变量
#   - 企业配置中心（Nacos/Apollo/Spring Cloud Config 等）：把下列键托管到中心，
#     由启动器/agent 注入进程环境变量即可，本项目无需任何改动
#   - 密钥（*_PASSWORD / IW_MODEL_API_KEY）只允许动态注入，禁止写入仓库与镜像层
#
# 会话存储（Redis）
IW_REDIS_HOST=127.0.0.1
IW_REDIS_PORT=6379
IW_REDIS_PASSWORD=

# 模型接入（OpenAI-compatible，BYOK）
# base-url 形式因框架而异：python/go 需含 /v1（如 https://api.deepseek.com/v1），
# java(Spring AI) 不带 /v1（如 https://api.deepseek.com）
IW_MODEL_BASE_URL=
IW_MODEL_NAME=
IW_MODEL_API_KEY=

# 对方核心系统：mock（本地演示与评测确定性）| mysql（真实只读取数）
IW_CORE_MODE=mock
IW_MYSQL_HOST=127.0.0.1
IW_MYSQL_PORT=3306
IW_MYSQL_USER=root
IW_MYSQL_PASSWORD=
IW_MYSQL_DATABASE=icewright_core

# 非实时交互回推回调（可选；留空=仅轮询 GET /messages/{msgid}/files）
IW_CALLBACK_URL=

# 异步结果文件存储（客户决策项，设计文档第 8 节）：
#   本地模式——IW_FILES_DIR 配置目录（留空=默认 data/files，Python 栈默认 app/data/files），单机开箱即用；
#   远端/共享模式——客户提供对象存储/共享盘 SDK，整层替换各栈 saveFile/loadFile（接口层，业务代码不动）。
#   多实例/负载均衡部署必须选远端模式，否则下载请求打到没有该文件的实例会 404。
IW_FILES_DIR=

# 身份校验与隔离（设计文档第 9 节：组/会话/用户/用户类型四层隔离）
# 与客户网关注入的 X-IW-User / X-IW-Group / X-IW-Role / X-IW-Sign 头配套：
#   X-IW-Sign = HMAC-SHA256(IW_AUTH_SECRET, "user|group|role") 十六进制小写。
#   IW_AUTH_SECRET 留空=调试模式（本机免签直开 /admin；生产必须配置，配置后所有请求须带签名头）。
#   客户已有统一认证体系时只替换各栈 identity 层的 verify/identify 一个函数，业务代码不动。
IW_AUTH_SECRET=
