{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IceWright Desktop",
  "version": "0.1.0",
  "identifier": "dev.icewright.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IceWright 构建监控",
        "width": 1080,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
